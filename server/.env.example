# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/documind

# ---- Auth ----
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ---- LLM (summaries + answers) ----
# anthropic | openai | mock   (mock = offline, no API key, extractive answers only)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- Embeddings (semantic search) ----
# openai | voyage | local   (local = hashed bag-of-words, works offline but is NOT truly semantic)
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5

# ---- Uploads / processing ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
PROCESSING_CONCURRENCY=2
MAX_PROCESSING_ATTEMPTS=3
